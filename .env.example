# Kopieer naar .env op de VPS (/var/www/smit-site/.env) en vul in.
# Het offerteformulier mailt via Resend (https://resend.com).

# Verplicht: API-sleutel van Resend
RESEND_API_KEY=re_xxxxxxxxx

# Optioneel: waar de aanvragen naartoe gaan (standaard: k.smitinstallatietechniek@outlook.com)
# OFFERTE_NAAR=k.smitinstallatietechniek@outlook.com

# Optioneel: afzender. Moet een domein zijn dat in Resend geverifieerd is.
# OFFERTE_VAN=SMIT Installatie Techniek <noreply@snellio.nl>
